<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_seasons_branch_list" model="ir.ui.view">
        <field name="name">seasons.branch.list</field>
        <field name="model">seasons.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_ids" widget="many2many_tags"/>
                <field name="region_id"/>
                <field name="township_id"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_seasons_branch_form" model="ir.ui.view">
        <field name="name">seasons.branch.form</field>
        <field name="model">seasons.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_ids" widget="many2many_tags"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="region_id"/>
                            <field name="township_id"/>
                            <field name="address"/>
                            <field name="opening_hours"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_seasons_branch_search" model="ir.ui.view">
        <field name="name">seasons.branch.search</field>
        <field name="model">seasons.branch</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="region_id"/>
                <field name="township_id"/>
            </search>
        </field>
    </record>

    <record id="action_seasons_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">seasons.branch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_seasons_branch_search"/>
    </record>

</odoo>