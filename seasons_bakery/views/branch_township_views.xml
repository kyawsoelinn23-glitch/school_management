<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="view_branch_township_list" model="ir.ui.view">
        <field name="name">branch.township.list</field>
        <field name="model">branch.township</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="branch_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_branch_township_form" model="ir.ui.view">
        <field name="name">branch.township.form</field>
        <field name="model">branch.township</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="branch_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_branch_township_search" model="ir.ui.view">
        <field name="name">branch.township.search</field>
        <field name="model">branch.township</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="branch_ids"/>
            </search>
        </field>
    </record>

    <record id="action_branch_township" model="ir.actions.act_window">
        <field name="name">Branch Townships</field>
        <field name="res_model">branch.township</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>