<?xml version="1.0" encoding="utf-8" ?>

<odoo>

    <record id="view_branch_region_list" model="ir.ui.view">
        <field name="name">branch.region.list</field>
        <field name="model">branch.region</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="branch_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_branch_region_form" model="ir.ui.view">
        <field name="name">branch.region.form</field>
        <field name="model">branch.region</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="branch_ids" widget="many2many_tags">
                            <list>
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_branch_region_search" model="ir.ui.view">
        <field name="name">branch.region.search</field>
        <field name="model">branch.region</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>


    <record id="action_branch_region" model="ir.actions.act_window">
        <field name="name">Branch Regions</field>
        <field name="res_model">branch.region</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>