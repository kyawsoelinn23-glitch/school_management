<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_school_student" model="ir.sequence">
        <field name="name">Student Sequence</field>
        <field name="code">school.student</field>
        <field name="prefix">STU/%(day)s/%(month)s/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>

    <record model="ir.sequence" id="seq_school_teacher">
        <field name="name">Teacher Sequence</field>
        <field name="code">school.teacher</field>
        <field name="prefix">EID_</field>
        <field name="suffix">/%(day)s/%(month)s/%(year)s</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>