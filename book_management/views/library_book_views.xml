<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_library_book_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="book_name"/>
                <field name="isbn"/>
                <field name="author"/>
                <field name="published_date"/>
                <field name="price"/>
                <field name="category_id"/>
                <field name="author_ids" widget="many2many_tags"/>
                <field name="available_copies"/>
                <field name="book_code"/>
            </list>
        </field>
    </record>
    <record id="view_library_book_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_book_code" string="Generate Book Code" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="book_name"/>
                            <field name="isbn"/>
                            <field name="author"/>
                            <field name="published_date"/>
                            <field name="price"/>
                        </group>
                        <group>
                            <field name="available_copies"/>
                            <field name="book_code" readonly="1"/>
                            <field name="active"/>
                            <field name="category_id"/>
                            <field name="author_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_library_root" name="Library"/>
    <menuitem id="menu_library_book" name="Books" parent="menu_library_root" action="action_library_book"/>
    <menuitem id="menu_library_book_categories" name="Book Categories" parent="menu_library_root" action="action_library_book_category"/>
    <menuitem id="menu_library_authors" name="Authors" parent="menu_library_root" action="action_library_author"/>
    <menuitem id="menu_library_borrow" name="Borrowing" parent="menu_library_root" action="action_library_borrow"/>


</odoo>