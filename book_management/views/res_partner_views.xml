<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_partner_form_library_member" model="ir.ui.view">
        <field name="name">res.partner.form.library.member</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Library Member Information">
                    <group>
                        <field name="is_library_member"/>
                        <field name="member_code" readonly="True" invisible="not is_library_member"/>
                        <field name="membership_date" invisible="not is_library_member"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>