<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_library_book_report_wizard_form" model="ir.ui.view">
        <field name="name">library.book.report.wizard.form</field>
        <field name="model">library.book.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Library Book Report">
                <group>
                    <field name="category_id"/>
                    <field name="from_date"/>
                    <field name="to_date"/>
                </group>
                <footer>
                    <button
                        name="action_print_excel" string="Print Excel" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_library_book_report_wizard" model="ir.actions.act_window">
        <field name="name">Library Book Report</field>
        <field name="res_model">library.book.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_library_book_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_library_book_report" name="Reporting" parent="book_management.menu_library_root" sequence="50"/>
    <menuitem id="menu_library_book_report_wizard" name="Library Book Report" parent="menu_library_book_report" action="action_library_book_report_wizard" sequence="10"/>


</odoo>